# the API origin reached directly: Socket.IO, the wake-up ping and the
# target of the /api/* proxy in vite dev and preview
VITE_SOCKET_URL=http://localhost:5000

# REST calls go to the page's own origin (proxied), as on Vercel;
# set this only to call the API cross-origin instead
# VITE_API_ORIGIN=http://localhost:5000

# only when the API runs with ORIGIN_SECRET: the proxy adds it as
# x-origin-secret, as vercel.json does
# ORIGIN_SECRET=
